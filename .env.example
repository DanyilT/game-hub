# Supabase settings for accounts. Copy this file to .env.local and fill it in from the
# Left empty, the site runs without accounts and "Sign in" shows "soon".
#
# Both values are public: Vite puts them into the built site. Never put the secret key
# (sb_secret_…) or the database password in a VITE_ variable.

# e.g. https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_URL=
# e.g. sb_publishable_…
VITE_SUPABASE_PUBLISHABLE_KEY=
