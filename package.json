{
  "name": "game-hub",
  "version": "2.0.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check:catalog": "node scripts/check-catalog.mjs",
    "catalog:pull": "node scripts/catalog-pull.mjs",
    "games:pull": "node scripts/games-pull.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:worker": "node --test worker/*.test.js worker/games/*.test.js",
    "storybook": "storybook dev -c dev/storybook/.storybook -p 6006",
    "storybook:build": "storybook build -c dev/storybook/.storybook -o dev/storybook/dist",
    "cf:preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@vitejs/plugin-react": "^6.1.1",
    "sass-embedded": "^1.105.0",
    "sharp": "^0.35.4",
    "storybook": "^10.6.1",
    "supabase": "^2.118.0",
    "vite": "^8.3.1",
    "wrangler": "^4.139.0"
  }
}
