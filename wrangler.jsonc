// Cloudflare Workers config: serves the Vite build (dist/) as static files.
// There's no server code. `npm run deploy` builds and uploads it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-hub",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    // Every page has a file of its own (e.g. games/snake.html, written by vite.config.js), so it's
    // a 200. Any other path gets 404.html with a 404 status, and the app shows its 404 page there.
    "not_found_handling": "404-page"
  }
}
