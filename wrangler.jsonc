// Cloudflare Workers config: serves the Vite build (dist/) as static files, plus a small script
// (worker/index.js) that keeps the free Supabase project awake. `npm run deploy` builds and
// uploads both.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-hub",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    // Files are served without running the script. It gets only the requests no file matches,
    // and hands them back through this binding.
    "binding": "ASSETS",
    // Every page has a file of its own (e.g. games/snake.html, written by vite.config.js), so it's
    // a 200. Any other path gets 404.html with a 404 status, and the app shows its 404 page there.
    "not_found_handling": "404-page"
  },
  "triggers": {
    // The Supabase keep-alive, every 6 hours (at :17). Its two settings are secrets, set once:
    //   npx wrangler secret put SUPABASE_URL
    //   npx wrangler secret put SUPABASE_PUBLISHABLE_KEY
    "crons": ["17 */6 * * *"]
  },
  // The dashboard's Logs tab: each keep-alive run, and the few requests the script sees
  "observability": { "enabled": true }
}
